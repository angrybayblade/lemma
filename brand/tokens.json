{
  "name": "Lemma",
  "version": "1.0.0",
  "color": {
    "ink": "#20241F",
    "paper": "#F5F2EB",
    "white": "#FFFEFA",
    "linen": "#EAE6DC",
    "line": "#D7D5CB",
    "muted": "#65685F",
    "vermilion": "#BA432B",
    "vermilionHover": "#9E3623",
    "vermilionSoft": "#F5E1D8",
    "forest": "#355C48",
    "forestSoft": "#E3EBE1",
    "amber": "#805C16",
    "amberSoft": "#F2E9CC",
    "slate": "#526071",
    "slateSoft": "#E6EAF0",
    "night": "#191D19",
    "nightSurface": "#242A24",
    "nightLine": "#454D43",
    "nightMuted": "#B2B8AC",
    "nightAccent": "#F29A7D"
  },
  "font": {
    "display": "'Instrument Serif', Georgia, serif",
    "sans": "'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "mono": "'Geist Mono', 'SFMono-Regular', Consolas, monospace"
  },
  "type": {
    "xs": "0.75rem",
    "sm": "0.875rem",
    "base": "1rem",
    "lg": "1.125rem",
    "xl": "1.5rem",
    "h3": "2rem",
    "h2": "3rem",
    "h1": "4.5rem",
    "display": "6rem"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "3rem",
    "8": "4rem",
    "9": "6rem"
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "pill": "999px"
  },
  "motion": {
    "fast": "120ms",
    "normal": "180ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "layout": {
    "max": "75rem",
    "reading": "42rem"
  },
  "theme": {
    "light": {
      "bg": "paper",
      "surface": "white",
      "subtle": "linen",
      "fg": "ink",
      "secondary": "muted",
      "border": "line",
      "controlBorder": "muted",
      "accent": "vermilion",
      "accentHover": "vermilionHover",
      "onAccent": "white",
      "focus": "vermilion",
      "satisfied": "forest",
      "satisfiedBg": "forestSoft",
      "violated": "vermilionHover",
      "violatedBg": "vermilionSoft",
      "unknown": "slate",
      "unknownBg": "slateSoft",
      "stale": "amber",
      "staleBg": "amberSoft"
    },
    "dark": {
      "bg": "night",
      "surface": "nightSurface",
      "subtle": "ink",
      "fg": "paper",
      "secondary": "nightMuted",
      "border": "nightLine",
      "controlBorder": "nightMuted",
      "accent": "nightAccent",
      "accentHover": "vermilionSoft",
      "onAccent": "night",
      "focus": "nightAccent",
      "satisfied": "#A2D2AC",
      "satisfiedBg": "#233D2C",
      "violated": "nightAccent",
      "violatedBg": "#482C24",
      "unknown": "#B6C9E2",
      "unknownBg": "#293746",
      "stale": "#E3C678",
      "staleBg": "#40371F"
    }
  }

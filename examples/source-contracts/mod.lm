module source_contracts

import * as typescript from lemma.typescript
import * as python from lemma.python
import * as go from lemma.go

export service Accounts {
    export operation typescript {
        implementation: typescript.file("handler.ts").symbol("setStatus")
    }

    export operation python {
        implementation: python.file("handler.py").symbol("set_status")
    }

    export operation go {
        implementation: go.file("handler.go").symbol("setStatus")
    }
}

let commit = {
    assumption: "The dependency atomically checks the scoped lease; rejected writes leave storage unchanged; the call has no other effects"
    parameters: ["project", "enabled", "epoch"]
    returns: { rejected: { expr: "lease.rejected" } }
    effect: {
        name: "commit"
        fields: {
            project: { expr: "project" }
            enabled: { expr: "enabled" }
            epoch: { expr: "epoch" }
        }
    }
}

let status_contract = {
    inputs: {
        request: { allowed: "Bool", enabled: "Bool", project: "Text", epoch: "Text" }
        lease: { rejected: "Bool" }
    }
    parameters: ["request"]
    models: { commitStatus: commit, commit_status: commit }
    ensures: [
        {
            name: "success_requires_permission_and_accepted_lease"
            condition: "result.success == (request.allowed && !lease.rejected)"
        },
        { name: "permission_before_write", condition: "!effects.commit.called || request.allowed" },
        {
            name: "project_scope"
            condition: "!effects.commit.called || effects.commit.last.project == request.project"
        },
        {
            name: "lease_epoch"
            condition: "!effects.commit.called || effects.commit.last.epoch == request.epoch"
        },
        {
            name: "requested_status"
            condition: "!effects.commit.called || effects.commit.last.enabled == request.enabled"
        },
        { name: "write_before_success", condition: "!result.success || effects.commit.called" }
    ]
}

export checker prove(handler: Operation, contract: Json): Evidence<Json> {
    engine: "proof"
    timeout_ms: 30000
}

export behavior status_implementation_matches_contract {
    for handler in [Accounts.typescript, Accounts.python, Accounts.go] {
        let proof = need prove(handler: handler, contract: status_contract)
        expect proof.holds
        expect proof.status == "conditional"
        expect proof.assumptions == [commit.assumption]
    }
}

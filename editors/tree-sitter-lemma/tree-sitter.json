{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "lemma",
      "camelcase": "Lemma",
      "title": "Lemma",
      "scope": "source.lemma",
      "file-types": [
        "lm"
      ],
      "injection-regex": "^lemma$",
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "description": "Tree-sitter grammar for Lemma's .lm language"
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
